# ---------------------------------------------------------------------------
# MovieFlix frontend — copy to `.env.local` and adjust.
# Parsed and validated in src/lib/env.ts; the app fails fast on a bad value.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time. NEVER put a
# secret behind that prefix. Server-only values have no prefix.
# ---------------------------------------------------------------------------

# ---- API ----
# Used by the browser. Must be reachable from the user's machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Used by Server Components / Route Handlers. Same value locally; in Docker or
# on a platform this is usually an internal hostname (e.g. http://api:3001/api/v1).
API_BASE_URL=http://localhost:3001/api/v1

# Abort an API request after this many milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# ---- App ----
NEXT_PUBLIC_APP_NAME=MovieFlix
NEXT_PUBLIC_APP_URL=http://localhost:3000
