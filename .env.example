# ---------------------------------------------------------------------------
# MovieFlix frontend — copy to `.env.local` and adjust.
# Parsed and validated in src/lib/env.ts; the app fails fast on a bad value.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time. NEVER put a
# secret behind that prefix. Server-only values have no prefix.
# ---------------------------------------------------------------------------

# ---- API ----
# Used by the browser.
#   Local: the API's own origin. Both sides are on localhost, so the auth
#          cookies are already shared and nothing needs proxying.
#   Split hosts (Vercel + Railway): set this to the RELATIVE path "/api/v1" and
#          fill API_PROXY_ORIGIN below. The browser then calls this app, which
#          forwards to the API. Same origin means no CORS, and the session
#          cookies stay first-party — see the comment in next.config.ts.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Used by Server Components / Route Handlers. Always ABSOLUTE, including when
# the browser goes through the proxy: there is no document on the server to
# resolve a relative path against. In Docker this is often an internal hostname
# (e.g. http://api:3001/api/v1).
API_BASE_URL=http://localhost:3001/api/v1

# Set ONLY when the API lives on another host. Origin, no trailing slash and no
# path — e.g. https://moviefix-api.up.railway.app. Empty locally.
API_PROXY_ORIGIN=

# Abort an API request after this many milliseconds.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# ---- App ----
NEXT_PUBLIC_APP_NAME=MovieFlix
NEXT_PUBLIC_APP_URL=http://localhost:3000
